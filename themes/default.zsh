# Default terminal-lab theme: ANSI color variables used by the CLI menu
# and status output. Other themes should define the same variable set.

BHARGI_COLOR_PRIMARY=$'\033[38;5;39m'
BHARGI_COLOR_ACCENT=$'\033[38;5;208m'
BHARGI_COLOR_OK=$'\033[38;5;42m'
BHARGI_COLOR_WARN=$'\033[38;5;220m'
BHARGI_COLOR_ERROR=$'\033[38;5;196m'
BHARGI_COLOR_DIM=$'\033[38;5;244m'
BHARGI_COLOR_RESET=$'\033[0m'
