#!/usr/bin/env zsh
# termlab — personal terminal command center.
#
# Usage:
#   termlab                launch the interactive menu
#   termlab <module> [...] run a module command directly, e.g. `termlab system info`
#   termlab --help          list modules
#
# TERMLAB_ACTIVE guards against relaunching the menu from inside itself
# (see the "T -> Terminal" option and shell/zsh/init.zsh's startup hook).

set -o pipefail

TERMLAB_HOME="${TERMLAB_HOME:-$(cd "$(dirname "${0:A}")/.." && pwd)}"
export TERMLAB_HOME
export TERMLAB_ACTIVE=1

source "$TERMLAB_HOME/shell/functions/config.zsh"

theme_file="$TERMLAB_HOME/themes/${TERMLAB_THEME:-default}.zsh"
[ -f "$theme_file" ] || theme_file="$TERMLAB_HOME/themes/default.zsh"
source "$theme_file"

source "$TERMLAB_HOME/cli/lib/platform.zsh"
source "$TERMLAB_HOME/cli/lib/menu.zsh"
source "$TERMLAB_HOME/cli/lib/modules.zsh"

main() {
    if [ $# -eq 0 ]; then
        termlab_menu
        return $?
    fi

    case "$1" in
        -h|--help|help)
            termlab_print_help
            ;;
        T|t|terminal|Terminal)
            termlab_go_to_terminal
            ;;
        platform)
            termlab_platform_summary
            ;;
        *)
            termlab_dispatch "$@"
            ;;
    esac
}

main "$@"
